# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# --- Server ---------------------------------------------------------------
PORT=8080
# "production" enables the HTTPS redirect and turns off verbose logging
NODE_ENV=development

# --- Enquiry notifications ------------------------------------------------
# The inbox that receives every website enquiry. Keep this the same as the
# address shown in the site footer.
NOTIFY_EMAIL=bluejetholidaypune@gmail.com

# Gmail will not accept your normal account password here. Create an App
# Password instead: Google Account > Security > 2-Step Verification >
# App passwords. Paste the 16-character value into SMTP_PASS with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bluejetholidaypune@gmail.com
SMTP_PASS=

# Leaving SMTP_USER or SMTP_PASS blank is safe: enquiries are still captured
# in data/leads.ndjson and the server logs a warning at boot. It just means
# nothing lands in the inbox.

# --- Security -------------------------------------------------------------
# Signs admin tokens. Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Allowed CORS origin. Set to the live site once deployed.
FRONTEND_URL=http://localhost:8080

# --- Optional -------------------------------------------------------------
# MongoDB is a secondary store. Enquiries are written to data/leads.ndjson
# first, so the site works correctly with this left unset.
MONGODB_URI=mongodb://localhost:27017/bluejet-holidays
